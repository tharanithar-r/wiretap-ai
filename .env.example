# ===== LiveKit =====
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Agent name registered in LiveKit cloud (matches agent.py cli.run_app agent_name)
LIVEKIT_AGENT_NAME=

# ===== Telephony (Telnyx -> LiveKit trunk) =====
# Outbound trunk id created in LiveKit Cloud (Telephony -> SIP trunks)
SIP_OUTBOUND_TRUNK_ID=
# The number the manager/customer is called at (E.164)
TARGET_NUMBER=+91
# Caller ID shown to the recipient (your Telnyx US number)
SIP_FROM_NUMBER=

# ===== Speech / Voice =====
# Default stack: Soniox (STT) + Cartesia Sonic (TTS). Sarvam stays in the code
# as a fallback — set STT_PROVIDER=sarvam / TTS_PROVIDER=sarvam to use it.

# --- Soniox STT (default) ---
SONIOX_API_KEY=
# --- Cartesia Sonic TTS (default) ---
CARTESIA_API_KEY=
# Model: sonic-3.5 (sub-90ms, multilingual). Voice: Jacqueline (featured female,
# native Hindi accent, adapts to ta/te/hi/en).
CARTESIA_MODEL=sonic-3.5
CARTESIA_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# --- Sarvam AI (fallback: Telugu/Hindi/Tamil/English, code-switching) ---
SARVAM_API_KEY=
SARVAM_SPEAKER=shreya
# STT: "unknown" = auto-detect per utterance; TTS: "unknown" = auto-detect per utterance
# (or pin a language like te-IN / hi-IN / ta-IN / en-IN)
SARVAM_STT_LANG=unknown
SARVAM_TTS_LANG=unknown

# ===== LLM (DeepSeek, OpenAI-compatible) =====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== API (the agent's tools call this to fire WhatsApp / store leads) =====
# Public URL of the deployed API (e.g. https://webhook.yourdomain.com)
API_BASE_URL=http://localhost:3000

# ===== WhatsApp (Baileys) =====
# Recipient for mid-call / follow-up messages (the manager's number, E.164 digits only)
WHATSAPP_TO=91
# Your mobile number shown in the follow-up (E.164 digits only)
YOUR_NUMBER=

# ===== API trigger auth =====
# Secret shared with the trigger client (sent as X-API-Key header)
API_SECRET=
PORT=3000